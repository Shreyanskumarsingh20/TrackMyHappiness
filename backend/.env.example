# Server configuration
PORT=4000
HOST=0.0.0.0

# SQLite database path
DB_PATH=./data/trackmyhappiness.db

# Active global tracking provider ($0 options first!):
#   free_direct   -> $0 Live Direct (Japan Post + Cainiao/China cross-border + optional free DHL key + 1-tap carrier links)
#   whereparcel   -> $0 Free Tier (1,000 trackings/month, NO credit card, ~200 global couriers)
#   simulator     -> Built-in realistic worldwide demo simulator
#   17track       -> Optional 17TRACK API v2.2
#   ship24        -> Optional Ship24 API v1
#   trackingmore  -> Optional TrackingMore API v4
TRACKING_PROVIDER=free_direct

# $0 Free-Tier / Developer Keys (optional — also configurable inside the app Settings tab)
# WhereParcel format: API_KEY:SECRET_KEY (https://whereparcel.com - 1,000 free/mo, no credit card)
WHEREPARCEL_API_KEY=
# Free DHL Developer key (https://developer.dhl.com - Shipment Tracking Unified API)
DHL_API_KEY=

# Optional Business Aggregator Keys
TRACK17_API_KEY=
SHIP24_API_KEY=
TRACKINGMORE_API_KEY=

# Background auto-check frequency (in minutes)
POLL_INTERVAL_MINUTES=30

# Default destination country
DEFAULT_DESTINATION_COUNTRY=India
