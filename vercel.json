{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run vercel:build",
  "outputDirectory": "mobile/dist",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 30,
      "includeFiles": "backend/dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.mjs"
    },
    {
      "source": "/((?!_expo|assets|favicon\\.ico|metadata\\.json|api).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/poll",
      "schedule": "0 8 * * *"
    }
  ]
}
